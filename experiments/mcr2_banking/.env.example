MCR_DB_OWNER_PASSWORD=replace-with-a-long-random-owner-password
MCR_DB_APP_PASSWORD=replace-with-a-different-long-random-app-password
MCR_AGENT_TOKEN=replace-with-a-long-random-agent-token
MCR_WINDOW_START_UTC=06:00
MCR_WINDOW_END_UTC=22:00
# Single-transaction cap for a LOW risk-tier counterparty; MEDIUM/HIGH tiers
# apply the multipliers below on top of this.
MCR_BASE_RISK_LIMIT=10000.00
MCR_RISK_TIER_MEDIUM_MULT=0.50
MCR_RISK_TIER_HIGH_MULT=0.10
# cross_border_wire applies this on top of the tier multiplier above, since
# cross-border settlement carries extra correspondent-banking/FX risk.
MCR_CROSS_BORDER_LIMIT_MULT=0.50
# Rolling-window concentration caps (per counterparty, per agent). Nostro
# exposure caps per correspondent bank are reference data, not env config
# (see db/schema.sql: correspondent_bank_reference).
MCR_COUNTERPARTY_EXPOSURE_CAP=25000.00
MCR_AGENT_EXPOSURE_CAP=60000.00
MCR_EXPOSURE_WINDOW_HOURS=24
# Rate limiting: max authorized transactions per agent in this many seconds.
MCR_VELOCITY_WINDOW_SECONDS=60
MCR_VELOCITY_MAX_TX=5
# Structuring/smurfing detection: N-or-more transactions at or above
# (single-tx limit * fraction) within this window is flagged.
MCR_STRUCTURING_WINDOW_SECONDS=600
MCR_STRUCTURING_NEAR_LIMIT_FRACTION=0.80
MCR_STRUCTURING_COUNT_THRESHOLD=3
